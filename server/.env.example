MONGODB_URI=mongodb://localhost:27017/nexcart
PORT=5000
CORS_ORIGIN=https://shoeshopawesome.netlify.app,http://localhost:5173
WS_PATH=/ws/chat
JWT_SECRET=CLIENT_SECRET_KEY
WS_MAX_MESSAGE_LENGTH=2000
WS_MAX_PAYLOAD_BYTES=16384
WS_RATE_WINDOW_MS=10000
WS_RATE_MAX=20
WS_HEARTBEAT_MS=30000
# Local Ollama is free and needs no API key. Without a running Ollama server,
# the assistant uses the database-backed catalog and FAQ fallback.
AI_PROVIDER=ollama
AI_API_KEY=
AI_MODEL=qwen2.5:3b
AI_BASE_URL=http://127.0.0.1:11434/v1
